{
  "$schema": "https://opencode.ai/config.json",
  // Dual brain: Fireworks (primary fast) + OpenRouter (secondary finance/free) concurrent ensemble → rules
  // Fireworks: accounts/fireworks/models/llama-v3p3-70b-instruct | deepseek-v3p1 | qwen3-235b-a22b-instruct-2507 | ling-3-flash
  // OpenRouter: inclusionai/ling-3.0-flash-fin:free | deepseek/deepseek-r1:free | qwen/qwen3-235b-a22b:free
  "model": "fireworks/llama-v3p3-70b-instruct",
  "small_model": "fireworks/llama-v3p3-70b-instruct",
  "provider": {
    "fireworks": {
      "options": {
        "apiKey": "{env:FIREWORKS_API_KEY}",
        "baseURL": "https://api.fireworks.ai/inference/v1"
      }
    },
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}",
        "baseURL": "https://openrouter.ai/api/v1"
      }
    }
  },
  "mcp": {
    "alpaca-paper-trading": {
      "type": "local",
      "command": ["uvx", "alpaca-mcp-server"],
      "enabled": true,
      "environment": {
        "ALPACA_API_KEY": "{env:APCA_API_KEY_ID}",
        "ALPACA_SECRET_KEY": "{env:APCA_API_SECRET_KEY}",
        "ALPACA_PAPER_TRADE": "true"
      }
    }
  },
  "instructions": [
    "You are Vega, autonomous options alpha agent. Use Fireworks AI + OpenRouter concurrent ensemble for finance reasoning. Pick best confidence+edge_bps. Always output strict JSON."
  ]
}
