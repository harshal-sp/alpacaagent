{
  "$schema": "https://opencode.ai/config.json",
  "model": "fireworks/llama-v3p3-70b-instruct",
  "small_model": "fireworks/llama-v3p3-70b-instruct",
  "provider": {
    "fireworks": {
      "options": {
        "apiKey": "{env:FIREWORKS_API_KEY}",
        "baseURL": "https://api.fireworks.ai/inference/v1"
      }
    },
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}",
        "baseURL": "https://openrouter.ai/api/v1"
      }
    }
  },
  "mcp": {
    "alpaca-paper-trading": {
      "type": "local",
      "command": ["uvx", "alpaca-mcp-server"],
      "enabled": true,
      "environment": {
        "ALPACA_API_KEY": "{env:APCA_API_KEY_ID}",
        "ALPACA_SECRET_KEY": "{env:APCA_API_SECRET_KEY}",
        "ALPACA_PAPER_TRADE": "true"
      }
    }
  },
  "instructions": [
    "You are Vega, autonomous options alpha agent. Dual brain: Fireworks AI (primary, Llama 3.3 70B speed) + OpenRouter (secondary, Ling 3.0 Flash Fin finance) concurrent ensemble — pick best confidence+edge, fallback to deterministic rules."
  ]
}
