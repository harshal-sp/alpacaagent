# Alpaca Paper Trading — NEVER commit real keys
APCA_API_KEY_ID=PK_YOUR_PAPER_KEY_HERE
APCA_API_SECRET_KEY=YOUR_PAPER_SECRET_HERE
APCA_PAPER=true

# --- Fireworks AI (primary, speed) ---
# https://app.fireworks.ai/settings/users/api-keys  Docs: https://docs.fireworks.ai/getting-started/quickstart
FIREWORKS_API_KEY=fw_...
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct
# Alt: accounts/fireworks/models/deepseek-v3p1 | qwen3-235b-a22b-instruct-2507 | fireworks/ling-3-flash

# --- OpenRouter (secondary, finance-tuned + free) ---
# https://openrouter.ai/keys  Docs: https://openrouter.ai/docs
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-fin:free
# Alt free: deepseek/deepseek-r1:free | qwen/qwen3-235b-a22b:free | meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_REFERRER=https://lablab.ai
OPENROUTER_TITLE=Vega Options Alpha

# LLM tuning — both providers run concurrently, best pick wins; rules is final fallback
LLM_CONCURRENT=true
LLM_TIMEOUT_S=18
LLM_CACHE_TTL_S=90

# Agent tuning
CONFIRMATION_MODE=off
RISK_MODE=aggressive
LOG_LEVEL=INFO

# Trading Universe Preset or Custom Comma-Separated Symbols
# Presets: CORE (default 16 high-performers), MAG_SEVEN, TECH, AI_AND_SEMIS, HIGH_BETA_MOMENTUM, INDEX_ETFS, ALL
# Or custom list: TRADING_UNIVERSE=SPY,QQQ,NVDA,AAPL,PLTR,AVGO,COIN,AMZN,GOOGL,META,TSLA,NFLX,IWM,SMH
TRADING_UNIVERSE=CORE
