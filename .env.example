# Alpaca Paper Trading — NEVER commit real keys
APCA_API_KEY_ID=PK_YOUR_PAPER_KEY_HERE
APCA_API_SECRET_KEY=YOUR_PAPER_SECRET_HERE
APCA_PAPER=true

# Featherless AI (for LLM brain) — $25 credits
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct
# Alternative local: OPENAI_BASE_URL=http://localhost:1234/v1

# Optional fallbacks
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Agent tuning
CONFIRMATION_MODE=off
RISK_MODE=aggressive
LOG_LEVEL=INFO
