# Alpaca Paper Trading — NEVER commit real keys
APCA_API_KEY_ID=PK_YOUR_PAPER_KEY_HERE
APCA_API_SECRET_KEY=YOUR_PAPER_SECRET_HERE
APCA_PAPER=true

# --- Ling 3.0 Flash Fin (primary finance-native, free via OpenRouter/Vercel AI Gateway through Sep 25) ---
# Get free key: https://openrouter.ai (NovitaAI free) or https://vercel.com/ai-gateway or https://opencode.ai
LING_API_KEY=
# or OPENROUTER_API_KEY / AI_GATEWAY_API_KEY / ANT_LING_API_KEY (any one)
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=
LING_BASE_URL=https://openrouter.ai/api/v1
LING_MODEL=inclusionai/ling-3.0-flash-fin:free
# Opencode direct (no key needed when using `opencode run -m opencode/ling-3.0-flash-fin-free`)
OPENCODE_LING_MODEL=opencode/ling-3.0-flash-fin-free

# Featherless AI (secondary, $25 credits)
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct
# Alternative local: OPENAI_BASE_URL=http://localhost:1234/v1

# Optional fallbacks
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Agent tuning
CONFIRMATION_MODE=off
RISK_MODE=aggressive
LOG_LEVEL=INFO
